        <div class="modal-dialog modal-dialog-centered edit-deck-modal">
            <div class="modal-content">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="staticBackdropLabel">Edit this deck</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form method="post">
                <div class="modal-body">
                        <div class="mb-3">
                            <label for="updatedDeckTitle" class="form-label">Deck Title<div class="input-asterisk">*</div></label>
                            <input type="text" class="form-control" id="updatedDeckTitle" value="@Model.deck.deckTitle" name="updatedDeckTitle" required>
                        </div>
                        <div class="mb-3">
                            <label for="updatedDeckDescription" class="form-label">Deck Description</label>
                            <input type="text" class="form-control" id="updatedDeckDescription" value="@Model.deck.deckDescription" placeholder="Enter deck description" name="updatedDeckDescription">
                        </div>
                        <div class="mb-3">
                            <label for="updatedDeckImagePath" class="form-label">Deck Image</label>
                            <input type="text" class="form-control" id="updatedDeckImagePath" value="@Model.deck.deckImagePath" placeholder="Enter deck image URL" name="updatedDeckImagePath">
                            <input type="hidden" id="originalDeckId" name="originalDeckId" value="@Model.deck.deckId" />
                        </div>
                    </>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    <button type="submit" asp-page-handler="UpdateDeck" class="btn btn-primary" id="updateDeckButton">Save</button>
                </div>
                </form>
            </div>
        </div>
    </div>

<button type="button" class="btn btn-primary" id="deleteDeckButton" data-id=@Model.deck.deckId>
