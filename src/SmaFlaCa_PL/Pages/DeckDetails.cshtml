<div class="modal fade" id="addCardModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered add-card-modal">
        <div class="modal-content">
            <form method="post">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="staticBackdropLabel">Create your new card</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                    <div class="mb-3">
                        <label for="cardQuestion" class="form-label">Question<div class="input-asterisk">*</div></label>
                        <input type="text" class="form-control" id="cardQuestion" placeholder="Enter question" name="newCardQuestion" required>
                    </div>
                    <div class="mb-3">
                        <label for="cardAnswer" class="form-label">Answer</label>
                        <input type="text" class="form-control" id="cardAnswer" placeholder="Enter answer" name="newCardAnswer">
                    </div>
                    <div class="mb-3">
                        <label for="cardImagePath" class="form-label">Card Image</label>
                        <input type="text" class="form-control" id="cardImagePath" placeholder="Enter card image URL" name="newCardImagePath">
                        <input type="hidden" id="newCardDeckId" name="newCardDeckId" value="@Model.deck.deckId" />
                    </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="submit" asp-page-handler="CreateFlashcard" class="btn btn-primary" id="addCardButton">Add</button>
            </div>
            </form>
        </div>
    </div>
</div> *@
   
