@page
@model SmaFlaCa_PL.Pages.DeckDetailsModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home</title>
    <link rel="stylesheet" href="~/css/HomeStyle.css" asp-append-version="true" />
    <script src="~/js/detailsPage.js" defer></script>
</head>
<body>

<h1>Deck details</h1>

<img src="@Model.deck.deckImagePath"
     alt="Deck image"
     class="img-fluid" />

<p><strong>ID:</strong> @Model.deck.deckId</p>
<p>@Model.deck.deckDescription</p>
@foreach (var card in Model.flashcards)
{
    <div class="col">
        <div class="card">
            <img src="@card.cardImagePath" class="card-img-top" alt=",,,">
            <div class="card-body">
                <h4 class="card-title">@card.question</h4>
                <p class="card-text">@card.answer</p>
                    <button type="button" class="btn btn-primary" id="deleteCardButton" data-id=@card.cardId>
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash-fill" viewBox="0 0 16 16">
                            <path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0" />
                        </svg>
                    </button>
            </div>
        </div>
    </div>
}

<a asp-page="/Index" class="btn btn-secondary">
    Back to decks
</a>
<button type="button" class="btn btn-primary" id="deleteDeckButton" data-id=@Model.deck.deckId>
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash-fill" viewBox="0 0 16 16">
        <path d="M2.5 1a1 1 0 0 0-1 1v1a1 1 0 0 0 1 1H3v9a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V4h.5a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H10a1 1 0 0 0-1-1H7a1 1 0 0 0-1 1zm3 4a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 .5-.5M8 5a.5.5 0 0 1 .5.5v7a.5.5 0 0 1-1 0v-7A.5.5 0 0 1 8 5m3 .5v7a.5.5 0 0 1-1 0v-7a.5.5 0 0 1 1 0" />
    </svg>
</button>

    <button type="button" class="btn btn-primary" id="editDeckButton" data-id="@Model.deck.deckId">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
             fill="currentColor" class="bi bi-pencil-fill" viewBox="0 0 16 16"
             aria-hidden="true">
            <path d="M12.854.146a.5.5 0 0 0-.707 0L10.5 1.793l3.707 3.707 1.647-1.647a.5.5 0 0 0 0-.707zM9.793 2.5 2 10.293V14h3.707l7.793-7.793z" />
        </svg>
    </button>

<button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#staticBackdrop">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-plus-circle" viewBox="0 0 16 16">
        <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16" />
        <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4" />
    </svg>
</button>

<div class="modal fade" id="staticBackdrop" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="staticBackdropLabel">Create your new card</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form class="addCardForm">
                    <div class="mb-3">
                        <label for="cardQuestion" class="form-label">Question<div class="input-asterisk">*</div></label>
                        <input type="text" class="form-control" id="cardQuestion" placeholder="Enter question" required>
                    </div>
                    <div class="mb-3">
                        <label for="cardAnswer" class="form-label">Answer</label>
                        <input type="text" class="form-control" id="cardAnswer" placeholder="Enter answer">
                    </div>
                    <div class="mb-3">
                        <label for="cardImagePath" class="form-label">Card Image</label>
                        <input type="text" class="form-control" id="cardImagePath" placeholder="Enter card image URL">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                <button type="submit" data-id=@Model.deck.deckId class="btn btn-primary" id="addCardButton">Add</button>
            </div>
        </div>
    </div>
</div>
    <form method="POST">
        <input type="hidden" id="newCardQuestion" name="newCardQuestion" />
        <input type="hidden" id="newCardAnswer" name="newCardAnswer" />
        <input type="hidden" id="newCardImagePath" name="newCardImagePath" />
        <input type="hidden" id="newCardDeckId" name="newCardDeckId" />

        <button type="submit"  id="submitNewCard" asp-page-handler="CreateFlashcard" style="display:none">Save</button>
    </form>
<form method="POST">
    <input type="hidden" id="selectedDeckId" name="selectedDeckId" />
    <button type="submit" id="submitDeleteDeck" asp-page-handler="DeleteDeck" style="display:none">Delete</button>
</form>

<form method="POST">
    <input type="hidden" id="selectedCardId" name="selectedCardId" />
    <input type="hidden" id="deckId" name="deckId" value="@Model.deck.deckId"/>
    <button type="submit" id="submitDeleteCard" asp-page-handler="DeleteFlashcard" style="display:none">Delete</button>
</form>
    
    


</body>
</html>