@page
@model IndexModel
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home</title>
    <link rel="stylesheet" href="~/css/HomeStyle.css" asp-append-version="true" />
    <script src="~/js/site.js"></script>
</head>
<body>
    <div class="row row-cols-1 row-cols-md-2 g-4">
        @foreach (var deck in Model.decks)
        {
            <div class="col">
                <div class="card">
                    <img src="@deck.deckImagePath" class="card-img-top" alt=",,,">
                    <div class="card-body">
                        <h4 class="card-title">@deck.deckTitle</h4>
                        <p class="card-text">@deck.deckDescription</p>
                    </div>
                </div>
            </div>
        }
    </div>
</body>
</html>
