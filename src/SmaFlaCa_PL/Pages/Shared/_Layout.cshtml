                    @* <!-- Stacked flashcards -->
                    <g transform="translate(8 8)">
                        <rect x="10" y="10" width="72" height="88" rx="16"
                              fill="#FF735C" transform="rotate(-9 46 54)" />
                        <rect x="18" y="8" width="72" height="88" rx="16"
                              fill="#FFFFFF" stroke="#172A45" stroke-width="5"
                              transform="rotate(6 54 52)" />

                        <!-- S-shaped flashcard mark -->
                        <path d="M68 34
                        C63 27 48 27 42 33
                        C34 41 41 48 53 52
                        C67 56 71 64 64 72
                        C58 79 43 79 36 72"
                              fill="none" stroke="#FF735C" stroke-width="8"
                              stroke-linecap="round" />
                    </g> *@

                  
                    
                        <g transform="translate(8 8)">
                            <rect x="10" y="10" width="72" height="88" rx="16"
                                  fill="#DDEFEA" transform="rotate(-9 46 54)" />
                            <rect x="18" y="8" width="72" height="88" rx="16"
                                  fill="#F5FAF8" stroke="#315C55" stroke-width="5"
                                  transform="rotate(6 54 52)" />
                            <path d="M68 34
                            C63 27 48 27 42 33
                            C34 41 41 48 53 52
                            C67 56 71 64 64 72
                            C58 79 43 79 36 72"
                                  fill="none" stroke="#73AFA2" stroke-width="8"
                                  stroke-linecap="round" />
                        </g>
                    </svg>

                </svg>

            </span>
            <span>SmaFlaCa</span>
        </a>

